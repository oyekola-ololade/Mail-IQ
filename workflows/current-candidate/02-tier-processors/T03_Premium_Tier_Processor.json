={{ $workflow.staticData.client_id }}"},{"name":"p2","value":"={{ $env.AES_MASTER_KEY }}"},{"name":"p3","value":"={{ $workflow.staticData.provider }}"}]}]}}},{"name":"Token Expired?","type":"n8n-nodes-base.if","typeVersion":2,"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict"},"conditions":[{"leftValue":"={{ new Date($json[0]?.expires_at) < new Date(Date.now() + 60000) }}","rightValue":true,"operator":{"type":"boolean","operation":"equals"}}]}}},{"name":"Call TW-05","type":"n8n-nodes-base.executeWorkflow","typeVersion":1.1,"parameters":{"workflowId":"TW-05: Token Refresh Handler"}},{"name":"Build Provider Request","type":"n8n-nodes-base.code","typeVersion":2,"parameters":{"jsCode":"const client = $input.first().json[0] || {};\nconst token = client.access_token;\nlet config = {};\nif (client.provider === 'gmail') {\n  const historyId = $input.first().json.historyId || $workflow.staticData.last_history_id;\n  config = {\n    url: 'https://gmail.googleapis.com/gmail/v1/users/me/messages',\n    query: { q: 'is:unread', maxResults: 10 },\n    headers: { Authorization: `Bearer ${token}` }\n  };\n} else {\n  const resource = $input.first().json.resource;\n  config = {\n    url: resource || 'https://graph.microsoft.com/v1.0/me/messages',\n    query: { $filter: 'isRead eq false', $top: 10 },\n    headers: { Authorization: `Bearer ${token}` }\n  };\n}\nreturn [{ json: config }];"}},{"name":"Fetch Emails","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"parameters":{"method":"GET","url":"={{ $json.url }}","sendQuery":true,"queryParameters":{"parameters":[{"name":"q","value":"={{ $json.query.q }}"},{"name":"maxResults","value":"={{ $json.query.maxResults }}"},{"name":"$filter","value":"={{ $json.query.$filter }}"},{"name":"$top","value":"={{ $json.query.$top }}"}]},"options":{"timeout":30000},"specifyHeaders":"json","jsonHeaders":"={{ JSON.stringify($json.headers) }}"}},{"name":"Has Emails?","type":"n8n-nodes-base.if","typeVersion":2,"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict"},"conditions":[{"leftValue":"={{ $json.resultSizeEstimate > 0 || ($json.value || []).length > 0 }}","rightValue":true,"operator":{"type":"boolean","operation":"equals"}}]}}},{"name":"Split Out","type":"n8n-nodes-base.splitInBatches","typeVersion":3,"parameters":{"batchSize":1}},{"name":"Dedup Check","type":"n8n-nodes-base.postgres","typeVersion":2.5,"parameters":{"operation":"executeQuery","connectionString":"={{ $env.N8N_DB_URL }}","options":{"connectionTimeout":30000,"queryTimeout":30000},"queries":{"values":[{"query":"SELECT id FROM email_log WHERE message_id = $1 AND client_id = $2","options":{"mode":"multiple"},"parameters":[{"name":"p1","value":"={{ $json.id }}"},{"name":"p2","value":"={{ $workflow.staticData.client_id }}"}]}]}}},{"name":"Already Sent?","type":"n8n-nodes-base.if","typeVersion":2,"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict"},"conditions":[{"leftValue":"={{ $json[0]?.id !== undefined }}","rightValue":true,"operator":{"type":"boolean","operation":"equals"}}]}}},{"name":"Get Email Detail","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"parameters":{"method":"GET","url":"={{ $workflow.staticData.provider === 'gmail' ? 'https://gmail.googleapis.com/gmail/v1/users/me/messages/' + $json.id + '?format=full' : 'https://graph.microsoft.com/v1.0/me/messages/' + $json.id + '?$select=id,subject,from,toRecipients,receivedDateTime,body,internetMessageHeaders' }}","options":{"timeout":30000},"specifyHeaders":"json","jsonHeaders":"={{ JSON.stringify({ Authorization: 'Bearer ' + $('Token Cache').first().json[0].access_token }) }}"}},{"name":"Decode Email","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"parameters":{"method":"POST","url":"={{ $env.PYTHON_SERVICE_URL }}/decode","sendBody":true,"bodyContentType":"json","specifyBody":"json","jsonBody":"={{ JSON.stringify({ raw_base64: $