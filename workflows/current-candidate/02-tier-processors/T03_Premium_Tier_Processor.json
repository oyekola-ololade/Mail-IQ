 week 3-Soft 2-FYI 1-Receipt\n\nAdditional:\n- If invoice/payment/recurring: compare to past amounts and note changes.\n- If deadline within 30 days: note it for calendar integration.\n- Reference previous email context if relevant.\n\nFormat:\nCategory [Category]\nScore [Score]/10 [red/yellow/green]\nSubject [Subject]\nSummary [Contextual summary with historical comparison if applicable]\nAction [Action]\n\nReply Draft: [Can be long and detailed]\nCalendar: [If deadline detected: \"Calendar event suggested.\"]\n\n_MailIQ Premium_"}]}},{"name":"Parse Output","type":"n8n-nodes-base.code","typeVersion":2,"parameters":{"jsCode":"const output = $input.first().json.output || $input.first().json.content || '';\nif (output.trim() === 'SKIP') return [{ json: { skip: true } }];\nconst categoryMatch = output.match(/Category\\s*(\\w+)/);\nconst urgencyMatch = output.match(/Score\\s*(\\d+)/);\nconst draftMatch = output.match(/Reply Draft:\\s*([\\s\\S]*?)(?=\nCalendar:|\n\n_MailIQ|$)/);\nconst calendarMatch = output.match(/Calendar:\\s*(.*)/);\nreturn [{ json: { output, category: categoryMatch ? categoryMatch[1] : 'other', urgency_score: urgencyMatch ? parseInt(urgencyMatch[1]) : 5, reply_draft: draftMatch ? draftMatch[1].trim() : 'No reply needed.', calendar_suggested: calendarMatch ? calendarMatch[1].trim() : '', skip: false } }];"}},{"name":"Not Skip?","type":"n8n-nodes-base.if","typeVersion":2,"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict"},"conditions":[{"leftValue":"={{ $json.skip === false }}","rightValue":true,"operator":{"type":"boolean","operation":"equals"}}]}}},{"name":"Send Message","type":"n8n-nodes-base.switch","typeVersion":2,"parameters":{"rules":{"rules":[{"value":"whatsapp","output":0},{"value":"telegram","output":1},{"value":"slack","output":2},{"value":"discord","output":3}]},"dataType":"string","value1":"={{ $workflow.staticData.platform }}"}},{"name":"Send WhatsApp","type":"n8n-nodes-base.evolutionApi",