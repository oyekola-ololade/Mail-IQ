{"name":"T01-Free: Free Tier Processor","nodes":[{"id":"bfb35c8b-0f24-4b97-85a8-1c00d16a1b7e","name":"Schedule Trigger","type":"n8n-nodes-base.scheduleTrigger","typeVersion":1.1,"position":[0,0],"parameters":{"rule":{"interval":[{"field":"minutes","minutesInterval":5}]},"options":{}}},{"id":"7a2cf7db-3c02-4f8d-a8e1-be70bda7fbc2","name":"Get Client Config","type":"n8n-nodes-base.postgres","typeVersion":2.5,"position":[200,0],"parameters":{"operation":"executeQuery","connectionString":"={{ $env.N8N_DB_URL }}","options":{"connectionTimeout":30000,"queryTimeout":30000,"nodeVersion":2.5},"queries":{"values":[{"query":"SELECT c.*, u.active_categories, u.urgency_threshold, u.is_throttled, u.quiet_hours_start, u.quiet_hours_end, u.timezone FROM clients c JOIN user_settings u ON c.id = u.client_id WHERE c.id = $1","options":{"mode":"multiple"},"parameters":[{"name":"p1","value":"={{ $workflow.staticData.client_id }}"}]}]}}},{"id":"92af3d61-0453-4a4a-bc8a-d91452971943","name":"Billing Gate","type":"n8n-nodes-base.if","typeVersion":2,"position":[400,0],"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict"},"conditions":[{"id":"3ea369dc-80f6-45c0-bdfd-2f3d49ea8ccc","leftValue":"={{ ['active','trialing'].includes($json[0]?.status) }}","rightValue":true,"operator":{"type":"boolean","operation":"equals"}}]}}},{"id":"25dc48f5-0830-4633-bbe1-bbc6c4b69a9d","name":"Throttle Gate","type":"n8n-nodes-base.if","typeVersion":2,"position":[600,0],"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict"},"conditions":[{"id":"61ca7fef-24ef-42a8-bcdc-3c84a4157476","leftValue":"={{ $json[0]?.is_throttled === false }}","rightValue":true,"operator":{"type":"boolean","operation":"equals"}}]}}},{"id":"dff63662-0320-4e58-bf21-ded477b4b079","name":"Check Limit","type":"n8n-nodes-base.postgres","typeVersion":2.5,"position":[800,0],"parameters":{"operation":"executeQuery","connectionString":"={{ $env.N8N_DB_URL }}","options":{"connectionTimeout":30000,"queryTimeout":30000,"nodeVersion":2.5},"queries":{"values":[{"query":"SELECT COALESCE(SUM(count), 0) as total FROM usage_events WHERE client_id = $1 AND event_type = 'email_processed' AND period_month = TO_CHAR(NOW(), 'YYYY-MM')","options":{"mode":"multiple"},"parameters":[{"name":"p1","value":"={{ $workflow.staticData.client_id }}"}]}]}}},{"id":"e08f3cc9-31ae-442e-80f1-33b32746143e","name":"Under Limit?","type":"n8n-nodes-base.if","typeVersion":2,"position":[1000,0],"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict"},"conditions":[{"id":"dd26910c-84b8-4983-97f3-3585c5f00267","leftValue":"={{ $json[0]?.total < 50 }}","rightValue":true,"operator":{"type":"boolean","operation":"equals"}}]}}},{"id":"1e205c11-480c-4a79-bb95-53e91b7f8a43","name":"Quiet Hours Check","type":"n8n-nodes-base.code","typeVersion":2,"position":[1200,0],"parameters":{"jsCode":"const settings = $input.first().json[0] || {};\nconst tz = settings.timezone || 'Africa/Lagos';\nconst now = new Date();\nconst hour = now.getHours();\nconst start = settings.quiet_hours_start;\nconst end = settings.quiet_hours_end;\nlet inQuiet = false;\nif (start != null && end != null) {\n  inQuiet = start < end ? (hour >= start && hour < end) : (hour >= start || hour < end);\n}\nreturn [{ json: { inQuiet, client_id: settings.id } }];"}},{"id":"3ce4d6f7-781b-4802-8527-becdbaebf457","name":"In Quiet Hours?","type":"n8n-nodes-base.if","typeVersion":2,"position":[1400,0],"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict"},"conditions":[{"id":"b3607373-9c5e-4b88-ac0f-25f0d295d5b3","leftValue":"={{ $json.inQuiet }}","rightValue":false,"operator":{"type":"boolean","operation":"equals"}}]}}},{"id":"26757abf-d6e7-4db7-98f1-75d8b078399a","name":"Queue Pending","type":"n8n-nodes-base.postgres","typeVersion":2.5,"position":[1400,200],"parameters":{"operation":"executeQuery","connectionString":"={{ $env.N8N_DB_URL }}","options":{"connectionTimeout":30000,"queryTimeout":30000,"nodeVersion":2.5},"queries":{"values":[{"query":"INSERT INTO pending_messages (client_id, send_after, sent) VALUES ($1, NOW() + INTERVAL '1 hour', false)","options":{"mode":"multiple"},"parameters":[{"name":"p1","value":"={{ $json.client_id }}"}]}]}}},{"id":"a4250a50-d9d8-4a84-99c3-0e67c857a515","name":"Token Cache","type":"n8n-nodes-base.postgres","typeVersion":2.5,"position":[1600,0],"parameters":{"operation":"executeQuery","connectionString":"={{ $env.N8N_DB_URL }}","options":{"connectionTimeout":30000,"queryTimeout":30000,"nodeVersion":2.5},"queries":{"values":[{"query":"SELECT pgp_sym_decrypt(access_token, $2) as access_token, expires_at FROM oauth_tokens WHERE client_id = $1 AND provider = $3","options":{"mode":"multiple"},"parameters":[{"name":"p1","value":"={{ $workflow.staticData.client_id }}"},{"name":"p2","value":"={{ $env.AES_MASTER_KEY }}"},{"name":"p3","value":"={{ $workflow.staticData.provider }}"}]}]}}},{"id":"ea0d6d50-b79a-4862-ad9f-31b4a94ee182","name":"Token Expired?","type":"n8n-nodes-base.if","typeVersion":2,"position":[1800,0],"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict"},"conditions":[{"id":"031a7524-abef-44a2-b0e4-66b0ff7bb4cf","leftValue":"={{ new Date($json[0]?.expires_at) < new Date(Date.now() + 60000) }}","rightValue":true,"operator":{"type":"boolean","operation":"equals"}}]}}},{"id":"2d320657-be8c-45dc-8c6e-42bcc91106e8","name":"Call TW-05","type":"n8n-nodes-base.executeWorkflow","typeVersion":1.1,"position":[1800,200],"parameters":{"workflowId":"TW-05: Token Refresh Handler","options":{}}},{"id":"2f4e86d2-b5a3-49a1-a508-ed635d590154","name":"Build Provider Request","type":"n8n-nodes-base.code","typeVersion":2,"position":[2000,0],"parameters":{"jsCode":"const client = $input.first().json[0] || {};\nconst token = client.access_token;\nlet config = {};\nif (client.provider === 'gmail') {\n  const lastCheck = $workflow.staticData.last_check || Math.floor((Date.now() - 300000) / 1000);\n  config = {\n    url: 'https://gmail.googleapis.com/gmail/v1/users/me/messages',\n    query: { q: `is:unread after:${lastCheck}`, maxResults: 10 },\n    headers: { Authorization: `Bearer ${token}` }\n  };\n} else {\n  const lastCheck = $workflow.staticData.last_check || new Date(Date.now() - 300000).toISOString();\n  config = {\n    url: 'https://graph.microsoft.com/v1.0/me/messages',\n    query: { $filter: `isRead eq false and receivedDateTime gt ${lastCheck}`, $top: 10 },\n    headers: { Authorization: `Bearer ${token}` }\n  };\n}\n$workflow.staticData.last_check = new Date().toISOString();\nreturn [{ json: config }];"}},{"id":"0435f0cf-a491-4e97-9dcd-323333466b8f","name":"Fetch Emails","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[2200,0],"parameters":{"method":"GET","url":"={{ $json.url }}","sendQuery":true,"queryParameters":{"parameters":[{"name":"q","value":"={{ $json.query.q }}"},{"name":"maxResults","value":"={{ $json.query.maxResults }}"},{"name":"$filter","value":"={{ $json.query.$filter }}"},{"name":"$top","value":"={{ $json.query.$top }}"}]},"options":{"timeout":30000},"specifyHeaders":"json","jsonHeaders":"={{ JSON.stringify($json.headers) }}"}},{"id":"a4bcebfe-abd5-4911-b240-d5c4e3dcfe0f","name":"Has Emails?","type":"n8n-nodes-base.if","typeVersion":2,"position":[2400,0],"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict"},"conditions":[{"id":"e48e72ae-dc76-49eb-810f-9f641d5da922","leftValue":"={{ $json.resultSizeEstimate > 0 || ($json.value || []).length > 0 }}","rightValue":true,"operator":{"type":"boolean","operation":"equals"}}]}}},{"id":"0a8db479-4f90-4dae-b2f0-bf046bd58543","name":"Split Out","type":"n8n-nodes-base.splitInBatches","typeVersion":3,"position":[2600,0],"parameters":{"batchSize":1,"options":{}}},{"id":"284933ca-4b77-47f8-bd6c-7981493bfdc2","name":"Dedup Check","type":"n8n-nodes-base.postgres","typeVersion":2.5,"position":[2800,0],"parameters":{"operation":"executeQuery","connectionString":"={{ $env.N8N_DB_URL }}","options":{"connectionTimeout":30000,"queryTimeout":30000,"nodeVersion":2.5},"queries":{"values":[{"query":"SELECT id FROM email_log WHERE message_id = $1 AND client_id = $2","options":{"mode":"multiple"},"parameters":[{"name":"p1","value":"={{ $json.id }}"},{"name":"p2","value":"={{ $workflow.staticData.client_id }}"}]}]}}},{"id":"245d4b98-fa4f-4e3d-b0dc-b023fccac186","name":"Already Sent?","type":"n8n-nodes-base.if","typeVersion":2,"position":[3000,0],"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict"},"conditions":[{"id":"4145b8e2-c8ad-4a02-98af-141dc7f88ee8","leftValue":"={{ $json[0]?.id !== undefined }}","rightValue":true,"operator":{"type":"boolean","operation":"equals"}}]}}},{"id":"69921bae-c4b0-4663-b909-2167add0ecb0","name":"Get Email Detail","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[3200,0],"parameters":{"method":"GET","url":"={{ $workflow.staticData.provider === 'gmail' ? 'https://gmail.googleapis.com/gmail/v1/users/me/messages/' + $json.id + '?format=full' : 'https://graph.microsoft.com/v1.0/me/messages/' + $json.id + '?$select=id,subject,from,toRecipients,receivedDateTime,body,internetMessageHeaders' }}","options":{"timeout":30000},"specifyHeaders":"json","jsonHeaders":"={{ JSON.stringify({ Authorization: 'Bearer ' + $('Token Cache').first().json[0].access_token }) }}"}},{"id":"0e6d4682-6048-4e02-be72-f984f44582ca","name":"Decode Email","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[3400,0],"parameters":{"method":"POST","url":"={{ $env.PYTHON_SERVICE_URL }}/decode","sendBody":true,"bodyContentType":"json","specifyBody":"json","jsonBody":"={{ JSON.stringify({ raw_base64: $json.payload?.body?.data || $json.body?.content, client_id: $workflow.staticData.client_id }) }}"}},{"id":"2b48d51a-72c4-4781-8143-070074b26236","name":"JS Fallback","type":"n8n-nodes-base.code","typeVersion":2,"position":[3400,200],"parameters":{"jsCode":"try {\n  const raw = $input.first().json;\n  return [{ json: { body: raw.snippet || raw.body?.content || '', subject: raw.payload?.headers?.find(h => h.name === 'Subject')?.value || raw.subject || '', from: raw.payload?.headers?.find(h => h.name === 'From')?.value || raw.from?.emailAddress?.address || '', messageId: raw.id } }];\n} catch (e) {\n  return [{ json: { body: '[Decode failed]', messageId: $input.first().json.id } }];\n}"}},{"id":"541a4528-7d6e-44a6-aa73-7f666d48955b","name":"AI Summarize","type":"n8n-nodes-base.lmChat","typeVersion":1,"position":[3600,0],"parameters":{"options":{},"model":"llama-3.3-70b-versatile","messages":[{"role":"system","content":"You are MailIQ Free. Deliver a helpful email summary.\n\nFrom: {{$json.from}}\nSubject: {{$json.subject}}\nBody: {{$json.body}}\n\nRules:\n- Categorize into ONE: job_opportunities, newsletters, finance, work_projects, legal, social_personal, shopping_orders, travel, security_alerts, health, school, other\n- One or two sentences ONLY for the summary.\n- NO urgency scores. NO red/yellow/green. NO action items.\n- If the email is a newsletter/receipt/FYI with no meaningful content, output: SKIP\n\nOutput format:\nCategory [Category]\n[Plain sentence summary]\n\n---\nUpgrade to Basic for urgency alerts and smart filtering.\nhttps://YOUR_PUBLIC_APP_URL/upgrade"}]}},{"id":"b01d43f4-55f6-4659-bf40-1f375381ac6c","name":"Parse Output","type":"n8n-nodes-base.code","typeVersion":2,"position":[3800,0],"parameters":{"jsCode":"const output = $input.first().json.output || $input.first().json.content || '';\nif (output.trim() === 'SKIP') return [{ json: { skip: true } }];\nconst categoryMatch = output.match(/Category\\s*(\\w+)/);\nreturn [{ json: { output, category: categoryMatch ? categoryMatch[1] : 'other', skip: false } }];"}},{"id":"88358b41-8abf-4b57-9821-662994d8a9ec","name":"Not Skip?","type":"n8n-nodes-base.if","typeVersion":2,"position":[4000,0],"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict"},"conditions":[{"id":"569ca3f9-dbeb-4863-a169-db84e252d0c0","leftValue":"={{ $json.skip === false }}","rightValue":true,"operator":{"type":"boolean","operation":"equals"}}]}}},{"id":"994ec8fd-d3ec-4104-aee4-e27a8a345ea7","name":"Send Message","type":"n8n-nodes-base.switch","typeVersion":2,"position":[4200,0],"parameters":{"rules":{"rules":[{"value":"whatsapp","output":0},{"value":"telegram","output":1},{"value":"slack","output":2},{"value":"discord","output":3}]},"dataType":"string","value1":"={{ $workflow.staticData.platform }}"}},{"id":"e1311b38-28aa-479e-ac42-37044bbc297b","name":"Send WhatsApp","type":"n8n-nodes-base.evolutionApi","typeVersion":1,"position":[4400,-100],"parameters":{"resource":"messages","operation":"send","instanceName":"={{ $env.EVOLUTION_INSTANCE }}","remoteJid":"={{ $workflow.staticData.phone }}","messageType":"text","text":"={{ $json.output }}"}},{"id":"5936f621-0ff3-4272-8e2f-347ecfd35920","name":"Send Telegram","type":"n8n-nodes-base.telegram","typeVersion":1.1,"position":[4400,0],"parameters":{"resource":"message","operation":"sendMessage","chatId":"={{ $workflow.staticData.platform_id }}","text":"={{ $json.output }}"}},{"id":"a1a7ef5d-6aca-4024-93a1-f3f961d9ac7e","name":"Send Slack","type":"n8n-nodes-base.slack","typeVersion":2.1,"position":[4400,100],"parameters":{"resource":"message","operation":"post","channel":"={{ $workflow.staticData.channel_id }}","text":"={{ $json.output }}"}},{"id":"e2958b30-ba1f-4f1b-9c9b-a2ada16a497c","name":"Send Discord","type":"n8n-nodes-base.discord","typeVersion":1,"position":[4400,200],"parameters":{"resource":"message","operation":"send","channelId":"={{ $workflow.staticData.channel_id }}","content":"={{ $json.output }}"}},{"id":"167b7a3a-3170-4886-b19b-3ae8bcc065c9","name":"Log Email","type":"n8n-nodes-base.postgres","typeVersion":2.5,"position":[4600,0],"parameters":{"oper