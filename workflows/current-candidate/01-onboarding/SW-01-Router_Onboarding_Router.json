{"name":"SW-01-Router: Onboarding Router","nodes":[{"id":"95882e69-1dc9-486e-80dc-7a42d928ca56","name":"Webhook","type":"n8n-nodes-base.webhook","typeVersion":1.1,"position":[0,0],"parameters":{"path":"/webhook/onboarding","responseMode":"responseNode","httpMethod":"POST","options":{}}},{"id":"7df049e3-66e6-4873-a21c-0a5886b87ea5","name":"Validate Payload","type":"n8n-nodes-base.code","typeVersion":2,"position":[200,0],"parameters":{"jsCode":"const body = $input.first().json.body;\nconst required = ['name', 'phone', 'email', 'provider', 'platform', 'tier', 'oauth_code', 'redirect_uri'];\nconst missing = required.filter(f => !body[f]);\nif (missing.length > 0) {\n  return [{ json: { valid: false, error: `Missing: ${missing.join(', ')}` } }];\n}\nfunction normalisePhone(raw) {\n  if (!raw) return '';\n  let p = String(raw).replace(/[\\s\\-().]/g, '');\n  if (p.startsWith('+')) p = p.slice(1);\n  if (/^0[789]\\d{8}$/.test(p)) p = '234' + p.slice(1);\n  return p;\n}\nbody.phone = normalisePhone(body.phone);\nreturn [{ json: { valid: true, data: body } }];"}},{"id":"0fc7db94-9bb4-4810-b09c-6269f74234ae","name":"Valid?","type":"n8n-nodes-base.if","typeVersion":2,"position":[400,0],"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict"},"conditions":[{"id":"0d08687e-8487-41dd-a30d-eef69ffa5ba2","leftValue":"={{ $json.valid }}","rightValue":true,"operator":{"type":"boolean","operation":"equals"}}]}}},{"id":"2007bfa7-4479-43c7-8821-a0c49ebfc329","name":"Error Response","type":"n8n-nodes-base.respondToWebhook","typeVersion":1,"position":[400,200],"parameters":{"options":{"responseCode":400},"respondWith":"json","responseBody":"={{ JSON.stringify({ error: $json.error }) }}"}},{"id":"930b179b-b3ff-460a-b4aa-04931252f09f","name":"Check OTP Verified","type":"n8n-nodes-base.postgres","typeVersion":2.5,"position":[600,0],"parameters":{"operation":"executeQuery","connectionString":"={{ $env.N8N_DB_URL }}","options":{"connectionTimeout":3