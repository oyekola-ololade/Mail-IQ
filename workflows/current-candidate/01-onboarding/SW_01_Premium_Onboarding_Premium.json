{"name":"SW-01-Premium_Onboarding_Premium","nodes":[{"id":"9eb7cb01-6a21-46c2-a2a8-31f58ffee768","name":"Receive Payload","type":"n8n-nodes-base.set","typeVersion":1,"position":[0,0],"parameters":{"values":{"string":[{"name":"data","value":"={{ $json }}"}]}}},{"id":"16eb2c61-9b9f-4fa5-8a85-f9c31ff9da5f","name":"Use Platform","type":"n8n-nodes-base.code","typeVersion":1,"position":[200,0],"parameters":{"jsCode":"const data = $input.first().json;\ndata.platform = data.platform || 'whatsapp';\ndata.destination_type = data.destination_type || 'personal';\ndata.messaging_platform = data.platform;\nreturn [{ json: data }];"}},{"id":"03c2d3ff-f74a-4887-8c83-0d9572695b98","name":"Create Client","type":"n8n-nodes-base.postgres","typeVersion":1,"position":[400,0],"parameters":{"operation":"executeQuery","query":"INSERT INTO clients (full_name, phone, email, tier, provider, platform, destination_type, is_active) VALUES ($1, $2, $3, 'premium', $4, $5, $6, false) RETURNING id","parameters":[{"name":"name","value":"={{ $json.name }}"},{"name":"phone","value":"={{ $json.phone }}"},{"name":"email","value":"={{ $json.email }}"},{"name":"provider","value":"={{ $json.provider }}"},{"name":"platform","value":"={{ $json.platform }}"},{"name":"destination_type","value":"={{ $json.destination_type }}"}]}},{"id":"754e8088-8c2d-4386-929c-18253f7486c3","name":"Get Limit","type":"n8n-nodes-base.postgres","typeVersion":1,"position":[600,0],"parameters":{"operation":"executeQuery","query":"SELECT email_limit FROM pricing WHERE tier = 'premium'"}},{"id":"05577b9b-cac9-4de0-a990-cb7d24fe1a2f","name":"Exchange OAuth","type":"n8n-nodes-base.httpRequest","typeVersion":1,"position":[400,200],"parameters":{"method":"POST","url":"={{$json.provider === 'gmail' ? 'https://oauth2.googleapis.com/token' : 'https://login.microsoftonline.com/common/oauth2/v2.0/token'}}","sendBody":true,"contentType":"form-urlencoded","body":{"client_id":"={{ $env.GOOGLE_CLIENT_ID }}","client_secret":"={{ $env.GOOGLE_CLIENT_SECRET }}","code":"={{ $json.oauth_code }}","redirect_uri":"={{ $json.redirect_uri }}","grant_type":"authorization_code","scope":"={{ $json.provider === 'outlook' ? 'Mail.Read offline_access' : undefined }}"}}},{"id":"e3e38ba0-d840-44fb-8e21-b6e78c5121d1","name":"OAuth Error","type":"n8n-nodes-base.httpRequest","typeVersion":1,"position":[600,400],"parameters":{"method":"POST","url":"={{$env.EVOLUTION_API_URL + '/message/sendText/' + $env.EVOLUTION_INSTANCE}}","sendBody":true,"contentType":"json","body":"={\"number\":\"{{$env.ADMIN_PHONE}}\",\"text\":\"MailIQ Error: OAuth failed for {{$json.name}} ({{$json.phone}})\"}"}},{"id":"817dc564-9b65-4d33-bbbc-f7e76c3a794d","name":"Encrypt & Store Tokens","type":"n8n-nodes-base.code","typeVersion":1,"position":[800,0],"parameters":{"jsCode":"const tokens = $input.first().json;\nconst clientId = $('Create Client').first().json.id;\nreturn [{ json: { client_id: clientId, access_token: tokens.access_token, refresh_token: tokens.refresh_token, expires_in: tokens.expires_in } }];"}},{"id":"ccacca48-d462-4567-9501-bf9d1c8aa72c","name":"Store OAuth","type":"n8n-nodes-base.postgres","typeVersion":1,"position":[1000,0],"parameters":{"operation":"executeQuery","query":"INSERT INTO oauth_tokens (client_id, provider, access_token, refresh_token, expires_at) VALUES ($1, $2, pgp_sym_encrypt($3, $4), pgp_sym_encrypt($5, $4), NOW() + INTERVAL '55 minutes')","parameters":[{"name":"client_id","value":"={{ $json.client_id }}"},{"name":"provider","value":"={{ $('Receive Payload').first().json.provider }}"},{"name":"access_token","value":"={{ $json.access_token }}"},{"name":"key","value":"={{ $env.AES_MASTER_KEY }}"},{"name":"refresh_token","value":"={{ $json.refresh_token }}"}]}},{"id":"e7984cc5-7158-40c7-a2bf-fd9f2ddfd9ac","name":"Create User Settings","type":"n8n-nodes-base.postgres","typeVersion":1,"position":[1200,0],"parameters":{"operation":"executeQuery","query":"INSERT INTO user_settings (client_id, active_categories, urgency_threshold, is_throttled) VALUES ($1, $2, $3, false)","parameters":[{"name":"client_id","value":"={{ $json.client_id }}"},{"name":"categories","value":"={{ JSON.stringify($('Receive Payload').first().json.active_categories || ['all']) }}"},{"name":"urgency","value":"={{ $('Receive Payload').first().json.urgency_threshold || 5 }}"}]}},{"id":"5f9aec1f-9962-42fd-82a3-688995cdcfc6","name":"Create Subscription","type":"n8n-nodes-base.postgres","typeVersion":1,"position":[1400,0],"parameters":{"operation":"executeQuery","query":"INSERT INTO subscriptions (client_id, plan, status, gateway, trial_ends_at) VALUES ($1, 'premium', 'active', 'paystack', NOW() + INTERVAL '7 days')","parameters":[{"name":"client_id","value":"={{ $json.client_id }}"}]}},{"id":"cb42695d-a54c-4768-a7f3-9fea1203d651","name":"Generate T03 JSON","type":"n8n-nodes-base.code","typeVersion":1,"position":[1600,0],"parameters":{"jsCode":"const clientId = $('Create Client').first().json.id;\nconst provider = $('Receive Payload').first().json.provider;\nconst webhookPath = '/email-push-' + clientId;\nconst workflowJson = {\n  name: 'T03-' + clientId,\n  nodes: [],\n  connections: {},\n  settings: { executionOrder: 'v1' },\n  staticData: { client_id: clientId, provider: provider, tier: 'premium', limit: null, webhook_path: webhookPath }\n};\nreturn [{ json: { workflow: JSON.stringify(workflowJson), client_id: clientId, webhook_path: webhookPath } }];"}},{"id":"46f5f5e1-0bfb-44b8-85a4-d2903cf7cde6","name":"Create Workflow","type":"n8n-nodes-base.n8n","typeVersion":1,"position":[1800,0],"parameters":{"operation":"create","workflowObject":"={{ $json.workflow }}"}},{"id":"36e88578-96b9-40b4-9154-86f42d1197a0","name":"Activate Workflow","type":"n8n-nodes-base.n8n","typeVersion":1,"position":[2000,0],"parameters":{"operation":"activate","workflowId":"={{ $json.id }}"}},{"id":"65bb22ca-3feb-453d-bd43-4c2c79bf8e6b","name":"Register Gmail Push","type":"n8n-nodes-base.httpRequest","typeVersion":1,"position":[2200,0],"parameters":{"m