odes-base.scheduleTrigger\",\n      typeVersion: 1.1,\n      position: [0, 0],\n      parameters: {\n        rule: { interval: [{ field: \"minutes\", minutesInterval: 5 }] }\n      }\n    }\n  ],\n  connections: {},\n  settings: { executionOrder: \"v1\" },\n  staticData: { client_id: clientId, provider: provider, limit: 50 }\n};\n\nreturn [{ json: { workflow: JSON.stringify(workflowJson), client_id: clientId } }];"}},{"id":"d51b48b2-6e62-4064-b035-9289bfbb3f11","name":"Create Workflow","type":"n8n-nodes-base.n8n","typeVersion":1,"position":[1800,0],"parameters":{"resource":"workflow","operation":"create","workflowObject":"={{ $json.workflow }}"}},{"id":"a996d985-22d0-49cd-994a-a29000160876","name":"Activate Workflow","type":"n8n-nodes-base.n8n","typeVersion":1,"position":[2000,0],"parameters":{"resource":"workflow","operation":"activate","workflowId":"={{ $json.id }}"}},{"id":"cb9bbfcf-b8f3-44d7-a4a6-658a34719864","name":"Update Client","type":"n8n-nodes-base.postgres","typeVersion":2.5,"position":[2200,0],"parameters":{"operation":"executeQuery","connectionString":"={{ $env.N8N_DB_URL }}","options":{"connectionTimeout":30000,"queryTimeout":30000,"nodeVersion":2.5},"queries":{"values":[{"query":"UPDATE clients SET workflow_id = $1, is_active = true WHERE id = $2","options":{"mode":"multiple"},"parameters":[{"name":"p1","value":"={{ $json.id }}"},{"name":"p2","value":"={{ $('Generate T01-Free JSON').item.json.client_id }}"}]}]}}},{"id":"38dc644d-3056-4012-98ef-9a1515d0ed3c","name":"Welcome Message","type":"n8n-nodes-base.evolutionApi","typeVersion":1,"position":[2400,0],"parameters":{"resource":"messages","operation":"send","instanceName":"={{ $env.EVOLUTION_INSTANCE }}","remoteJid":"={{ $('Receive Payload').item.json.phone }}","messageType":"text","text":"={{ 'MailIQ Free is Active!\\nHi ' + $('Receive Payload').item.json.name + ', your inbox is connected.\\nLimit: 50 emails/month\\nPlatform: WhatsApp\\nYour first summary arrives with your next unread email.\\nUpgra