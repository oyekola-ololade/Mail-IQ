{"name":"SW-01-Business_Onboarding_Business","nodes":[{"id":"fc2db926-576f-4068-a841-3f246aea3e90","name":"Receive Payload","type":"n8n-nodes-base.set","typeVersion":1,"position":[0,0],"parameters":{"values":{"string":[{"name":"data","value":"={{ $json }}"}]}}},{"id":"15a96664-44bc-4578-a634-32f3f0c15c0b","name":"Use Platform","type":"n8n-nodes-base.code","typeVersion":1,"position":[200,0],"parameters":{"jsCode":"const data = $input.first().json;\ndata.platform = data.platform || 'whatsapp';\ndata.destination_type = data.destination_type || 'personal';\ndata.messaging_platform = data.platform;\nreturn [{ json: data }];"}},{"id":"7b5a219d-f5b2-4185-8193-bfdd2d803a1c","name":"Create Client","type":"n8n-nodes-base.postgres","typeVersion":1,"position":[400,0],"parameters":{"operation":"executeQuery","query":"INSERT INTO clients (full_name, phone, email, tier, provider, platform, destination_type, is_active) VALUES ($1, $2, $3, 'business', $4, $5, $6, false) RETURNING id","parameters":[{"name":"name","value":"={{ $json.name }}"},{"name":"phone","value":"={{ $json.phone }}"},{"name":"email","value":"={{ $json.email }}"},{"name":"provider","value":"={{ $json.provider }}"},{"name":"platform","value":"={{ $json.platform }}"},{"name":"destination_type","value":"={{ $json.destination_type }}"}]}},{"id":"4f895a95-2a01-4fa7-a147-5ec1d6328875","name":"Get Limit","type":"n8n-nodes-base.postgres","typeVersion":1,"position":[600,0],"parameters":{"operation":"executeQuery","query":"SELECT email_limit FROM pricing WHERE tier = 'business'"}},{"id":"2167526c-ea2d-424e-b2a6-e09bac9d1e6b","name":"Exchange OAuth","type":"n8n-nodes-base.httpRequest","typeVersion":1,"position":[400,200],"parameters":{"method":"POST","url":"={{$json.provider === 'gmail' ? 'https://oauth2.googleapis.com/token' : 'https://login.microsoftonline.com/common/oauth2/v2.0/token'}}","sendBody":true,"contentType":"form-urlencoded","body":{"client_id":"={{ $env.GOOGLE_CLIENT_ID }}","client_secret":"={{ $env.GOOGLE_CLIENT_SECRET }}","code":"={{ $json.oauth_code }}","redirect_uri":"={{ $json.redirect_uri }}","grant_type":"authorization_code","scope":"={{ $json.provider === 'outlook' ? 'Mail.Read offline_access' : undefined }}"}}},{"id":"93862f7a-bfb8-49c4-a22c-d0c9108b1fb8","name":"OAuth Error","type":"n8n-nodes-base.httpRequest","typeVersion":1,"position":[600,400],"parameters":{"method":"POST","url":"={{$env.EVOLUTION_API_URL + '/message/sendText/' + $env.EVOLUTION_INSTANCE}}","sendBody":true,"contentType":"json","body":"={\"number\":\"{{$env.ADMIN_PHONE}}\",\"text\":\"MailIQ Error: OAuth failed for {{$json.name}} ({{$json.phone}})\"}"}},{"id":"f3a2075f-3144-4ef8-a5fb-58897a99fdec","name":"Encrypt & Store Tokens","type":"n8n-nodes-base.code","typeVersion":1,"position":[800,0],"parameters":{"jsCode":"const tokens = $input.first().json;\nconst clientId = $('Create Client').first().json.id;\nreturn [{ json: { client_id: clientId, access_token: tokens.access_token, refresh_token: tokens.refresh_token, expires_in: tokens.expires_in } }];"}},{"id":"4fe18780-73a7-4e7d-98f0-ef944d9e05d4","name":"Store OAuth","type":"n8n-nodes-base.postgres","typeVersion":1,"position":[1000,0],"parameters":{"operation":"executeQuery","query":"INSERT INTO oauth_tokens (client_id, provider, access_token, refresh_token, expires_at) VALUES ($1, $2, pgp_sym_encrypt($3, $4), pgp_sym_encrypt($5, $4), NOW() + INTERVAL '55 minutes')","parameters":[{"name":"client_id","value":"={{ $json.client_id }}"},{"name":"provider","value":"={{ $('Receive Payload').first().json.provider }}"},{"name":"access_token","value":"={{ $json.access_token }}"},{"name":"key","value":"={{ $env.AES_MASTER_KEY }}"},{"name":"refresh_token","value":"={{ $json.refresh_token }}"}]}},{"id":"b1052adb-3034-44df-b92c-e735afccae3d","name":"Create User Settings","type":"n8n-nodes-base.postgres","typeVersion":1,"position":[1200,0],"parameters":{"operation":"executeQuery","query":"INSERT INTO user_settings (client_id, active_categories, urgency_threshold, is_throttled) VALUES ($1, $2, $3, false)","parameters":[{"name":"client_id","value":"={{ $json.client_id }}"},{"name":"categories","value":"={{ JSON.stringify($('Receive Payload').first().json.active_categories || ['all']) }}"},{"name":"urgency","value":"={{ $('Receive Payload').first().json.urgency_threshold || 5 }}"}]}},{"id":"0368dc25-d34b-426c-bb00-581162ed8e1e","name":"Create Subscription","type":"n8n-nodes-base.postgres","typeVersion":1,"position":[1400,0],"parameters":{"operation":"executeQuery","query":"INSERT INTO subscriptions (client_id, plan, status, gateway, trial_ends_at) VALUES ($1, 'business', 'active', 'paystack', NOW() + INTERVAL '7 days')","parameters":[{"name":"client_id","value":"={{ $json.client_id }}"}]}},{"id":"2c0daac6-a486-4863-b503-6ea4d90ee66e","name":"Generate T03 JSON","type":"n8n-nodes-base.code","typeVersion":1,"position":[1600,0],"parameters":{"jsCode":"const clientId = $('Create Client').first().json.id;\nconst provider = $('Receive Payload').first().json.provider;\nconst webhookPath = '/email-push-' + clientId;\nconst workflowJson = {\n  name: 'T03-' + clientId,\n  nodes: [],\n  connections: {},\n  settings: { executionOrder: 'v1' },\n  staticData: { client_id: clientId, provider: provider, tier: 'business', limit: null, webhook_path: webhookPath }\n};\nreturn [{ json: { workflow: JSON.stringify(workflowJson), client_id: clientId, webhook_path: webhookPath } }];"}},{"id":"68cc6fa5-573c-44df-b4ee-e05b5917ad23","name":"Create Workflow","type":"n8n-nodes-base.n8n","typeVersion":1,"position":[1800,0],"parameters":{"operation":"create","workflowObject":"={{ $json.workflow }}"}},{"id":"8daa8b1e-f3fe-4b6b-8a97-c00fa6653f90","name":"Activate Workflow","type":"n8n-nodes-base.n8n","typeVersion":1,"position":[2000,0],"parameters":{"operation":"activate","workflowId":"={{ $json.id }}"}},{"id":"f4310eda-69fe-452f-b92d-ba80c25f6cd9","name":"Register Gmail Push","type":"n8n-nodes-base.httpRequest","typeVersion":1,"position":[2200,0],"parameter