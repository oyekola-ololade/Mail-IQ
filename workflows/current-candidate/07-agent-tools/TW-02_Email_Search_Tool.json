{"name":"TW-02: Email Search Tool","nodes":[{"id":"ade07671-56ad-412c-b7c6-a0c8b576ace5","name":"Receive Input","type":"n8n-nodes-base.set","typeVersion":3.2,"position":[0,0],"parameters":{"fields":{"values":[{"name":"client_id","value":"={{ $json.client_id }}","type":"string"},{"name":"query","value":"={{ $json.query }}","type":"string"},{"name":"days","value":"={{ $json.days || 30 }}","type":"number"}]},"options":{}}},{"id":"a30e3493-af1b-41c2-8b96-8bfe99bfbffa","name":"Search Postgres","type":"n8n-nodes-base.postgres","typeVersion":2.5,"position":[200,0],"parameters":{"operation":"executeQuery","connectionString":"={{ $env.N8N_DB_URL }}","options":{"connectionTimeout":30000,"queryTimeout":30000,"nodeVersion":2.5},"queries":{"values":[{"query":"SELECT subject, summary, sender_name, created_at FROM email_log WHERE client_id = $1 AND (subject ILIKE $2 OR summary ILIKE $2 OR body_text ILIKE $2) AND created_at > NOW() - INTERVAL '$3 days' ORDER BY created_at DESC LIMIT 5","options":{"mode":"multiple"},"parameters":[{"name":"p1","value":"={{ $json.client_id }}"},{"name":"p2","value":"={{ '%' + $json.query + '%' }}"},{"name":"p3","value":"={{ $json.days }}"}]}]}}},{"id":"64ff50f5-5ea6-43eb-a99d-f4f613a09b9a","name":"Format Results","type":"n8n-nodes-base.code","typeVersion":2,"position":[400,0],"parameters":{"jsCode":"const emails = $input.all()[0].json || [];\nif (!emails || emails.length === 0) {\n  return [{ json: { result: 'No emails found matching that query.' } }];\n}\nconst formatted = emails.map(e => `From: ${e.sender_name}\nSubject: ${e.subject}\nSummary: ${e.summary}\nDate: ${e.created_at}`).join('\n\n---\n\n');\nreturn [{ json: { result: formatted } }];"}},{"id":"4cc4e8ce-5982-45aa-bc99-ce1a45d52354","name":"Return to Caller","type":"n8n-nodes-base.respondToWebhook","typeVersion":1,"position":[600,0],"parameters":{"options":{"responseCode":200},"respondWith":"json","responseBody":"={{ JSON.stringify($json) }}"}}],"connections":{"Receive Input":{"main":[[{"node":"Search Postgres","type":"main","index":0}]]},"Search Postgres":{"main":[[{"node":"Format Results","type":"main","index":0}]]},"Format Results":{"main":[[{"node":"Return to Caller","type":"main","index":0}]]}},"settings":{"executionOrder":"v1"},"staticData":null,"tags":[]}