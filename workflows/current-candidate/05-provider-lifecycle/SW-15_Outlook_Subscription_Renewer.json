{"name":"SW-15_Outlook_Subscription_Renewer","nodes":[{"id":"6085532f-521f-4335-9963-75f12e67da04","name":"Schedule Trigger","type":"n8n-nodes-base.scheduleTrigger","typeVersion":1,"position":[0,0],"parameters":{"rule":{"interval":[{"field":"hours","expression":"0"},{"field":"minutes","expression":"0"}]},"mode":"custom"}},{"id":"13fe7f19-4262-4b7e-8457-34b98fe5c198","name":"Get Premium+ Outlook","type":"n8n-nodes-base.postgres","typeVersion":1,"position":[200,0],"parameters":{"operation":"executeQuery","query":"SELECT c.id, s.subscription_code, pgp_sym_decrypt(o.access_token, $1) as access_token FROM clients c JOIN subscriptions s ON c.id = s.client_id JOIN oauth_tokens o ON c.id = o.client_id WHERE c.tier IN ('premium', 'business') AND c.provider = 'outlook' AND c.is_active = true","parameters":[{"name":"key","value":"={{ $env.AES_MASTER_KEY }}"}]}},{"id":"6f0e19a8-1629-453e-b40c-494f4cf78514","name":"Split Out","type":"n8n-nodes-base.splitInBatches","typeVersion":1,"position":[400,0],"parameters":{"batchSize":1,"options":{}}},{"id":"3fd5b93e-04f4-4e15-b9dc-bfea796e5121","name":"Renew Subscription","type":"n8n-nodes-base.httpRequest","typeVersion":1,"position":[600,0],"parameters":{"method":"PATCH","url":"={{'https://graph.microsoft.com/v1.0/subscriptions/' + $json.subscription_code}}","sendHeaders":true,"headerParameters":{"parameters":[{"name":"Authorization","value":"={{'Bearer ' + $json.access_token}}"}]},"sendBody":true,"contentType":"json","body":"={\"expirationDateTime\": \"{{new Date(Date.now() + 423000*1000).toISOString()}}\"}"}},{"id":"1003c173-fe53-43c8-bdd4-ce074bad5cf7","name":"Log Renewal","type":"n8n-nodes-base.postgres","typeVersion":1,"position":[800,0],"parameters":{"operation":"executeQuery","query":"INSERT INTO health_check_logs (client_id, status, checked_at) VALUES ($1, 'outlook_renewed', NOW())","parameters":[{"name":"client_id","value":"={{ $json.id }}"}]}},{"id":"7d96298a-51bf-4236-a1e8-8060534d17b4","name":"Alert on Failure","type":"n8n-nodes-base.httpRequest","typeVersion":1,"position":[800,200],"parameters":{"method":"POST","url":"={{$env.N8N_WEBHOOK_BASE + '/admin-alerts'}}","sendBody":true,"contentType":"json","body":"={\"type\":\"oauth_refresh_failed\",\"client_id\":\"{{$json.id}}\",\"provider\":\"outlook\"}"}}],"connections":{"Schedule Trigger":{"main":[[{"node":"Get Premium+ Outlook","type":"main","index":0}]]},"Get Premium+ Outlook":{"main":[[{"node":"Split Out","type":"main","index":0}]]},"Split Out":{"main":[[{"node":"Renew Subscription","type":"main","index":0}]]},"Renew Subscription":{"main":[[{"node":"Log Renewal","type":"main","index":0}],[{"node":"Alert on Failure","type":"main","index":1}]]},"Log Renewal":{"main":[]}},"settings":{"executionOrder":"v1"},"tags":[]}
