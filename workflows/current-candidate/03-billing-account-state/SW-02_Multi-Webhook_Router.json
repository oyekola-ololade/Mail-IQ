{"name":"SW-02: Multi-Webhook Router","nodes":[{"id":"ff137928-ecd5-4a11-b3e3-1cda84ce4271","name":"Webhook Paystack","type":"n8n-nodes-base.webhook","typeVersion":1.1,"position":[0,0],"parameters":{"path":"/webhook/paystack","responseMode":"responseNode","httpMethod":"POST","options":{}}},{"id":"25677b98-1fe5-4dde-9738-8c6854bfdb0a","name":"Webhook Evolution","type":"n8n-nodes-base.webhook","typeVersion":1.1,"position":[0,-200],"parameters":{"path":"/webhook/evolution","responseMode":"responseNode","httpMethod":"POST","options":{}}},{"id":"e078d063-c0a8-4f44-946a-40885f3c9eb7","name":"Webhook Telegram","type":"n8n-nodes-base.webhook","typeVersion":1.1,"position":[0,-400],"parameters":{"path":"/webhook/telegram","responseMode":"responseNode","httpMethod":"POST","options":{}}},{"id":"dd62f2cf-d630-4216-a721-81a1b78256ab","name":"Webhook Slack","type":"n8n-nodes-base.webhook","typeVersion":1.1,"position":[0,-600],"parameters":{"path":"/webhook/slack","responseMode":"responseNode","httpMethod":"POST","options":{}}},{"id":"2bff4df5-6da0-4675-a1e2-a3fbdca652fe","name":"Webhook Discord","type":"n8n-nodes-base.webhook","typeVersion":1.1,"position":[0,-800],"parameters":{"path":"/webhook/discord","responseMode":"responseNode","httpMethod":"POST","options":{}}},{"id":"d492bed6-a717-47fb-89b9-ad8c9eab372f","name":"Verify Signature","type":"n8n-nodes-base.code","typeVersion":2,"position":[200,0],"parameters":{"jsCode":"const body = $input.first().json.body;\nconst headers = $input.first().json.headers || {};\nconst gateway = body.webhookUrl?.includes('paystack') ? 'paystack'\n  : body.webhookUrl?.includes('evolution') ? 'evolution'\n  : body.webhookUrl?.includes('telegram') ? 'telegram'\n  : body.webhookUrl?.includes('slack') ? 'slack'\n  : 'discord';\n\nlet valid = false;\nif (gateway === 'paystack') {\n  const crypto = require('crypto');\n  const hash = crypto.createHmac('sha512', $env.PAYSTACK_WEBHOOK_SECRET)\n    .update(JSON.stringify(body.body)).digest('hex');\n  valid = hash === headers['x-paystack-signature'];\n} else if (gateway === 'evolution') {\n  valid = headers['apikey'] === $env.EVOLUTION_API_KEY;\n} else if (gateway === 'telegram') {\n  valid = true;\n} else if (gateway === 'slack') {\n  const crypto = require('crypto');\n  const timestamp = headers['x-slack-request-timestamp'];\n  const sig = headers['x-slack-signature'];\n  const base = `v0:${timestamp}:${JSON.stringify(body.body)}`;\n  const hash = crypto.createHmac('sha256', $env.SLACK_SIGNING_SECRET).update(base).digest('hex');\n  valid = `v0=${hash}` === sig;\n} else if (gateway === 'discord') {\n  valid = true;\n}\n\nreturn [{ json: { valid, gateway, event: body.body } }];"}},{"id":"db498b21-79ca-4d6f-9543-0b874b762f71","name":"Invalid?","type":"n8n-nodes-base.if","typeVersion":2,"position":[400,0],"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict"},"conditions":[{"id":"0ad2bd20-ba03-48d5-84e1-cc5f3021117f","leftValue":"={{ $json.valid }}","rightValue":false,"operator":{"type":"boolean","operation":"equals"}}]}}},{"id":"efff1e3b-4ae3-4380-9cbf-b808c94d3860","name":"Respond 400","type":"n8n-nodes-base.respondToWebhook","typeVersion":1,"position":[400,200],"parameters":{"options":{"responseCode":400},"respondWith":"json","responseBody":"{\"error\":\"Invalid signature\"}"}},{"id":"fd7b439d-3585-4825-ba75-647bd67a0963","name":"Deduplicate","type":"n8n-nodes-base.postgres","typeVersion":2.5,"position":[600,0],"parameters":{"operation":"executeQuery","connectionString":"={{ $env.N8N_DB_URL }}","options":{"connectionTimeout":30000,"queryTimeout":30000,"nodeVersion":2.5},"queries":{"values":[{"query":"SELECT id FROM webhook_events WHERE gateway = $1 AND gateway_event_id = $2","options":{"mode":"multiple"},"parameters":[{"name":"p1","value":"={{ $json.gateway }}"},{"name":"p2","value":"={{ $json.event.id || $json.event.event_id || $json.event.data?.id }}"}]}]}}},{"id":"fe20f95a-37b6-4c70-821d-ca24543d9980","name":"Already Exists?","type":"n8n-nodes-base.if","typeVersion":2,"position":[800,0],"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict"},"conditions":[{"id":"afbd7ed7-8c84-4202-9b08-39caf5b8d1e5","leftValue":"={{ $json[0]?.id !== undefined }}","rightValue":true,"operator":{"type":"boolean","operation":"equals"}}]}}},{"id":"d85db8a1-fb7e-40c2-9c14-6d03b3d6fba5","name":"Respond 200","type":"n8n-nodes-base.respondToWebhook","typeVersion":1,"position":[800,200],"parameters":{"options":{"responseCode":200},"respondWith":"json","responseBody":"{\"status\":\"ok\"}"}},{"id":"5a0c539f-87f0-4917-ad12-81c66210e111","name":"Log Event","type":"n8n-nodes-base.postgres","typeVersion":2.5,"position":[1000,0],"parameters":{"operation":"executeQuery","connectionString":"={{ $env.N8N_DB_URL }}","options":{"connectionTimeout":30000,"queryTimeout":30000,"nodeVersion":2.5},"queries":{"values":[{"query":"INSERT INTO webhook_events (gateway, gateway_event_id, event_type, raw_payload, processed_at) VALUES ($1, $2, $3, $4, NOW())","options":{"mode":"multiple"},"parameters":[{"name":"p1","value":"={{ $json.gateway }}"},{"name":"p2","value":"={{ $json.event.id || $json.event.event_id || $json.event.data?.id }}"},{"name":"p3","value":"={{ $json.event.event }}"},{"name":"p4","value":"={{ JSON.stringify($json.event) }}"}]}]}}},{"id":"df6fe056-2974-4909-bfb8-dbfe62597294","name":"Route Event","type":"n8n-nodes-base.switch","typeVersion":2,"position":[1200,0],"parameters":{"rules":{"rules":[{"value":"paystack_charge.success","output":0},{"value":"paystack_subscription.disable","output":1},{"value":"paystack_invoice.payment_failed","output":2},{"value":"evolution_message.ack","output":3},{"value":"evolution_message.received","output":4},{"value":"telegram_callback_query","output":5},{"value":"discord_GUILD_CREATE","output":6}]},"dataType":"string","value1":"={{ $json.gateway + '_' + $json.event.event }}"}}],"connections":{"Webhook Paystack":{"main":[[{"node":"Verify Signature","type":"main","index":0}]]},"Webhook Evolution":{"main":[[{"node":"Verify Signature","type":"main","index":0}]]},"Webhook Telegram":{"main":[[{"node":"Verify Signature","type":"main","index":0}]]},"Webhook Slack":{"main":[[{"node":"Verify Signature","type":"main","index":0}]]},"Webhook Discord":{"main":[[{"node":"Verify Signature","type":"main","index":0}]]},"Verify Signature":{"main":[[{"node":"Invalid?","type":"main","index":0}]]},"Invalid?":{"main":[[{"node":"Deduplicate","type":"main","index":0}],[{"node":"Respond 400","type":"main","index":0}]]},"Deduplicate":{"main":[[{"node":"Already Exists?","type":"main","index":0}]]},"Already Exists?":{"main":[[{"node":"Log Event","type":"main","index":0}],[{"node":"Respond 200","type":"main","index":0}]]},"Log Event":{"main":[[{"node":"Route Event","type":"main","index":0}]]}},"settings":{"executionOrder":"v1"},"staticData":null,"tags":[]}