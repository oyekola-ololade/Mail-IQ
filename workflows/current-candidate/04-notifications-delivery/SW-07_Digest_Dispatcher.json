{"name":"SW-07: Digest Dispatcher","nodes":[{"id":"ee2d5890-b2ce-4d9f-9122-c0e5cbfac08a","name":"Schedule Trigger","type":"n8n-nodes-base.scheduleTrigger","typeVersion":1.1,"position":[0,0],"parameters":{"rule":{"interval":[{"field":"cronExpression","expression":"0 * * * *"}]},"options":{}}},{"id":"d878add4-9aeb-4c35-b903-bee0d5e754ba","name":"Get Pending Digests","type":"n8n-nodes-base.postgres","typeVersion":2.5,"position":[200,0],"parameters":{"operation":"executeQuery","connectionString":"={{ $env.N8N_DB_URL }}","options":{"connectionTimeout":30000,"queryTimeout":30000,"nodeVersion":2.5},"queries":{"values":[{"query":"SELECT client_id, STRING_AGG(summary, E'\n\n---\n\n') as batch FROM digest_queue WHERE created_at > NOW() - INTERVAL '1 hour' GROUP BY client_id","options":{"mode":"multiple"},"parameters":[]}]}}},{"id":"bfd80f09-40cb-43bc-a465-322d20f3bd69","name":"Split Out","type":"n8n-nodes-base.splitInBatches","typeVersion":3,"position":[400,0],"parameters":{"batchSize":1,"options":{}}},{"id":"0277142a-209c-45c4-b6a4-f5ee0491c0ef","name":"Get Platform Config","type":"n8n-nodes-base.postgres","typeVersion":2.5,"position":[600,0],"parameters":{"operation":"executeQuery","connectionString":"={{ $env.N8N_DB_URL }}","options":{"connectionTimeout":30000,"queryTimeout":30000,"nodeVersion":2.5},"queries":{"values":[{"query":"SELECT platform, platform_config FROM clients WHERE id = $1","options":{"mode":"multiple"},"parameters":[{"name":"p1","value":"={{ $json.client_id }}"}]}]}}},{"id":"77763920-5c19-4453-bb73-62932f872102","name":"Check Quiet Hours","type":"n8n-nodes-base.code","typeVersion":2,"position":[800,0],"parameters":{"jsCode":"const client = $input.first().json;\nconst settings = $('Get Platform Config').first().json[0] || {};\nconst hour = new Date().getHours();\nconst start = settings.quiet_hours_start;\nconst end = settings.quiet_hours_end;\nlet inQuiet = false;\nif (start != null && end != null) {\n  inQuiet = start < end ? (hour >= start && hour < end) 