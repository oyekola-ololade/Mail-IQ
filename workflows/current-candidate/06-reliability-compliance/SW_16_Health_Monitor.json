{"name":"SW-16_Health_Monitor","nodes":[{"id":"01126537-26b5-4150-afe3-6becb2c4fd88","name":"Schedule Trigger","type":"n8n-nodes-base.scheduleTrigger","typeVersion":1,"position":[0,0],"parameters":{"rule":{"interval":[{"field":"minutes","expression":"*/10"}]},"mode":"custom"}},{"id":"41ae5909-3acf-4250-9c1c-0c29dc7c955f","name":"Get Active Clients","type":"n8n-nodes-base.postgres","typeVersion":1,"position":[200,0],"parameters":{"operation":"executeQuery","query":"SELECT id, tier, last_email_at, workflow_id, created_at FROM clients WHERE is_active = true"}},{"id":"b20a977d-5480-44df-b76d-579081625d51","name":"Split Out","type":"n8n-nodes-base.splitInBatches","typeVersion":1,"position":[400,0],"parameters":{"batchSize":1}},{"id":"cf8c5e29-eac0-43a3-b22e-1569b257663a","name":"Check Stale","type":"n8n-nodes-base.code","typeVersion":1,"position":[600,0],"parameters":{"jsCode":"const client = $input.first().json;\nconst thresholds = { free: 30*60*1000, basic: 20*60*1000, standard: 10*60*1000, premium: 5*60*1000, business: 5*60*1000 };\nconst createdAt = new Date(client.created_at).getTime();\nconst lastEmail = client.last_email_at ? new Date(client.last_email_at).getTime() : createdAt;\nconst isNewUser = (Date.now() - createdAt) < 3600000;\nconst isStale = !isNewUser && (Date.now() - lastEmail > thresholds[client.tier]);\nreturn [{ json: { isStale, client_id: client.id, workflow_id: client.workflow_id, tier: client.tier, action_taken: null } }];"}},{"id":"03f6c141-21f6-4ecd-830f-8ad9aef7293b","name":"Stale?","type":"n8n-nodes-base.if","typeVersion":1,"position":[800,0],"parameters":{"conditions":{"options":{"caseSensitive":true,"leftEmpty":false,"rightEmpty":false},"conditions":[{"id":"f3b1a320-9098-4bc6-9d13-e1cc81f50d10","leftValue":"={{ $json.isStale }}","rightValue":"true","operator":{"type":"boolean","operation":"equals"}}]}}},{"id":"13c7d842-2d74-432e-97c9-30dcb86f7049","name":"Get Workflow Status","type":"n8n-nodes-base.httpRequest","typeVersion":1,"position":[1000,0],"parameters":{"method":"GET","url":"={{$env.N8N_API_URL + '/workflows/' + $json.workflow_id}}","sendHeaders":true,"headerParameters":{"parameters":[{"name":"X-N8N-API-KEY","value":"={{ $env.N8N_API_KEY }}"}]}}},{"id":"1f9a0447-3e31-4fcc-9be1-8d5669c3e09d","name":"Workflow Active?","type":"n8n-nodes-base.if","typeVersion":1,"position":[1200,0],"parameters":{"conditions":{"options":{"caseSensitive":true,"leftEmpty":false,"rightEmpty":false},"conditions":[{"id":"90d2cb80-25af-4062-8791-1cdcb6e448a3","leftValue":"={{ $json.active === false }}","rightValue":"true","operator":{"type":"boolean","operation":"equals"}}]}}},{"id":"6a4b8174-61a0-4a81-a43f-5a7f28f08595","name":"Alert Admin","type":"n8n-nodes-base.httpRequest","typeVersion":1,"position":[1400,0],"parameters":{"method":"POST","url":"={{$env.N8N_WEBHOOK_BASE + '/admin-alerts'}}","sendBody":true,"contentType":"json","body":"={\"type\":\"health_stale\",\"client_id\":\"{{$json.client_id}}\",\"tier\":\"{{$json.tier}}\"}"}},{"id":"b067260d-82ab-426b-afc2-9669d60083c2","name":"Attempt Resume","type":"n8n-nodes-base.httpRequest","typeVersion":1,"position":[1400,200],"parameters":{"method":"POST","url":"={{$env.N8N_API_URL + '/workflows/' + $json.workflow_id + '/activate'}}","sendHeaders":true,"headerParameters":{"parameters":[{"name":"X-N8N-API-KEY","value":"={{ $env.N8N_API_KEY }}"}]}}},{"id":"5795220a-7cf7-4d1f-8b62-4d03b54ecc55","name":"Log Health Check","type":"n8n-nodes-base.postgres","typeVersion":1,"position":[1600,0],"parameters":{"operation":"executeQuery","query":"INSERT INTO health_check_logs (client_id, status, checked_at, action_taken) VALUES ($1, $2, NOW(), $3)","parameters":[{"name":"client_id","value":"={{ $json.client_id }}"},{"name":"status","value":"={{ $json.isStale ? 'stale' : 'healthy' }}"},{"name":"action","value":"={{ $json.action_taken }}"}]}}],"connections":{"Schedule Trigger":{"main":[[{"node":"Get Active Clients","type":"main","index":0}]]},"Get Active Clients":{"main":[[{"node":"Split Out","type":"main","index":0}]]},"Split Out":{"main":[[{"node":"Check Stale","type":"main","index":0}]]},"Check Stale":{"main":[[{"node":"Stale?","type":"main","index":0}]]},"Stale?":{"main":[[{"node":"Get Workflow Status","type":"main","index":0}],[{"node":"Log Health Check","type":"main","index":1}]]},"Get Workflow Status":{"main":[[{"node":"Workflow Active?","type":"main","index":0}]]},"Workflow Active?":{"main":[[{"node":"Alert Admin","type":"main","index":0}],[{"node":"Attempt Resume","type":"main","index":1}]]},"Alert Admin":{"main":[[{"node":"Attempt Resume","type":"main","index":0}]]},"Attempt Resume":{"main":[[{"node":"Log Health Check","type":"main","index":0}]]},"Log Health Check":{"main":[]}},"settings":{"executionOrder":"v1"},"staticData":null,"tags":[]}