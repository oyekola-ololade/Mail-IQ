    {
      "id": "67f76d20-66c0-4404-927e-ae8e6df60a77",
      "name": "Validate Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        400
      ],
      "parameters": {
        "jsCode": "const body = $input.first().json;\n\nconst required = ['name', 'phone', 'email', 'provider', 'platform', 'tier', 'oauth_code', 'session_id'];\nconst missing = required.filter(f => !body[f] || body[f].toString().trim() === '');\n\nif (missing.length > 0) {\n  return [{\n    json: {\n      valid: false,\n      error: `Missing required fields: ${missing.join(', ')}`,\n      received: body\n    }\n  }];\n}\n\n// Normalize provider\nconst provider = body.provider.toLowerCase();\nconst validProviders = ['gmail', 'outlook'];\nif (!validProviders.includes(provider)) {\n  return [{\n    json: {\n      valid: false,\n      error: `Invalid provider: ${provider}. Must be gmail or outlook.`,\n      received: body\n    }\n  }];\n}\n\n// Normalize platform\nconst platform = body.platform.toLowerCase();\nconst validPlatforms = ['whatsapp', 'telegram', 'slack', 'discord'];\nif (!validPlatforms.includes(platform)) {\n  return [{\n    json: {\n      valid: false,\n      error: `Invalid platform: ${platform}`,\n      received: body\n    }\n  }];\n}\n\n// Normalize tier\nconst tier = body.tier.toLowerCase();\nconst validTiers = ['basic', 'standard', 'premium', 'business'];\nif (!validTiers.includes(tier)) {\n  return [{\n    json: {\n      valid: false,\n      error: `Invalid tier: ${tier}`,\n      received: body\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    valid: true,\n    name: body.name.trim(),\n    phone: body.phone.trim(),\n    email: body.email.trim().toLowerCase(),\n    provider: provider,\n    platform: platform,\n    tier: tier,\n    oauth_code: body.oauth_code,\n    session_id: body.session_id,\n    destination_type: body.destination_type || 'personal',\n    platform_config: body.platform_config || {},\n    categories: body.categories || ['All'],\n    urgency_threshold: body.urgency_threshold || 3,\n    timezone: body.timezone || 'Africa/Lagos',\n    quiet_hours_start: body.quiet_hours_start || null,\n    quiet_hours_end: body.quiet_hours_end || null\n  }\n}];"
      }
    },
    {
      "id": "e40d8a0b-d278-460a-aafe-2fec3b6e18f1",
