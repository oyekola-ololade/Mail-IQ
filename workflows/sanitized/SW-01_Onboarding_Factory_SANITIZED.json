    {
      "id": "3f7b3a27-052b-4d81-947d-879eb3fac4f7",
      "name": "Generate Child Workflow JSON",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3000,
        400
      ],
      "parameters": {
        "jsCode": "// ============================================================\n// This node loads a template JSON and injects client-specific values\n// In production, load template from file/DB instead of inline\n// ============================================================\n\nconst clientId = $node['Capture credentialId'].json.client_id;\nconst credentialId = $node['Capture credentialId'].json.credential_id;\nconst provider = $node['Validate Payload'].json.provider;\nconst platform = $node['Validate Payload'].json.platform;\nconst tier = $node['Validate Payload'].json.tier;\nconst destinationType = $node['Validate Payload'].json.destination_type;\n\n// Determine polling interval based on tier\nconst pollingInterval = tier === 'basic' ? 3 : 1; // minutes\n\n// Determine trigger type\nconst isPremium = ['premium', 'business'].includes(tier);\n\n// Build template lookup key\nconst templateKey = `${provider}-${platform}-${destinationType}`;\n\n// For now, return the injection parameters\n// The actual template JSON would be loaded from MinIO/DB\nreturn [{\n  json: {\n    client_id: clientId,\n    credential_id: credentialId,\n    provider: provider,\n    platform: platform,\n    tier: tier,\n    polling_interval: pollingInterval,\n    trigger_type: isPremium ? 'webhook' : 'schedule',\n    template_key: templateKey,\n    workflow_name: `example-child-${clientId}`,\n    tags: ['child-workflow', provider, platform, tier],\n    // These would be injected into the template JSON\n    inject: {\n      client_id: clientId,\n      credential_id: credentialId,\n      platform_config: $node['Validate Payload'].json.platform_config,\n      polling_interval: pollingInterval,\n      quiet_hours_start: $node['Validate Payload'].json.quiet_hours_start,\n      quiet_hours_end: $node['Validate Payload'].json.quiet_hours_end,\n      timezone: $node['Validate Payload'].json.timezone,\n      categories: $node['Validate Payload'].json.categories,\n      urgency_threshold: $node['Validate Payload'].json.urgency_threshold\n    }\n  }\n}];"
      }
    },
