        "operation": "executeQuery",
        "query": "SELECT verified, attempts, locked_until FROM verification_records WHERE phone = '{{ $node['Validate Payload'].json.phone }}' AND session_id = '{{ $node['Validate Payload'].json.session_id }}' ORDER BY created_at DESC LIMIT 1"
