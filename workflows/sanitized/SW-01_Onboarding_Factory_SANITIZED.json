            "type": "boolean"
          },
          "conditions": [
            {
              "id": "b569de48-a87b-42ae-8e46-e85967da28b3",
              "leftValue": "={{ $json.length > 0 && $json[0].verified === true && (!$json[0].locked_until || new Date($json[0].locked_until) < new Date()) }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ]
        }
      }
    },
